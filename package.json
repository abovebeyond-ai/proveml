{
  "name": "proveml",
  "version": "0.7.2",
  "description": "Deterministic claim-level verification for AI-generated text with Markdown-native inline markup.",
  "type": "module",
  "types": "src/index.d.ts",
  "main": "src/plugin.js",
  "bin": {
    "proveml": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/plugin.js"
    },
    "./verify": {
      "types": "./src/verify.d.ts",
      "default": "./src/verify.js"
    },
    "./thresholds": {
      "types": "./src/thresholds.d.ts",
      "default": "./src/thresholds.js"
    },
    "./render": {
      "types": "./src/render-html.d.ts",
      "default": "./src/render-html.js"
    },
    "./render-html": {
      "types": "./src/render-html.d.ts",
      "default": "./src/render-html.js"
    },
    "./renderer": {
      "types": "./src/renderer.d.ts",
      "default": "./src/renderer.js"
    },
    "./trust-adapter": {
      "types": "./src/trust-adapter.d.ts",
      "default": "./src/trust-adapter.js"
    },
    "./paper-examples": {
      "types": "./src/paper-examples.d.ts",
      "default": "./src/paper-examples.js"
    },
    "./style.css": "./src/style.css",
    "./annotate": {
      "types": "./src/annotate.d.ts",
      "default": "./src/annotate.js"
    },
    "./prompt": {
      "types": "./src/prompt.d.ts",
      "default": "./src/prompt.js"
    },
    "./review": {
      "types": "./src/review.d.ts",
      "default": "./src/review.js"
    },
    "./review-page": {
      "types": "./src/review-page.d.ts",
      "default": "./src/review-page.js"
    },
    "./review-flow": {
      "types": "./src/review-flow.d.ts",
      "default": "./src/review-flow.js"
    },
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "default": "./src/manifest.js"
    },
    "./diff": {
      "types": "./src/diff.d.ts",
      "default": "./src/diff.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "skills/vera/SKILL.md",
    "skills/vera/scripts/turn.mjs",
    "src/annotate.d.ts",
    "src/annotate.js",
    "src/cli.js",
    "src/core.js",
    "src/diff.d.ts",
    "src/diff.js",
    "src/index.d.ts",
    "src/manifest.d.ts",
    "src/manifest.js",
    "src/paper-examples.d.ts",
    "src/paper-examples.js",
    "src/plugin.js",
    "src/prompt.d.ts",
    "src/prompt.js",
    "src/render-html.d.ts",
    "src/render-html.js",
    "src/renderer.d.ts",
    "src/renderer.js",
    "src/review-flow.d.ts",
    "src/review-flow.js",
    "src/review-page.d.ts",
    "src/review-page.js",
    "src/review.d.ts",
    "src/review.js",
    "src/style.css",
    "src/thresholds.d.ts",
    "src/thresholds.js",
    "src/trust-adapter.d.ts",
    "src/trust-adapter.js",
    "src/types.d.ts",
    "src/verify.d.ts",
    "src/verify.js"
  ],
  "scripts": {
    "test": "node src/proveml.test.js && node src/grammar.test.js && node src/paper-examples.test.js && node src/cli.test.js && node src/detection.test.js && node src/prompt.test.js && node src/review.test.js && node src/review-page.test.js && node src/review-flow.test.js && node src/manifest.test.js && node src/diff.test.js && node src/attacks.test.js",
    "test:plugin": "node src/proveml.test.js",
    "test:grammar": "node src/grammar.test.js",
    "test:cli": "node src/cli.test.js",
    "test:detection": "node src/detection.test.js",
    "test:examples": "node src/paper-examples.test.js",
    "test:prompt": "node src/prompt.test.js",
    "test:review": "node src/review.test.js",
    "test:review-page": "node src/review-page.test.js",
    "test:review-flow": "node src/review-flow.test.js",
    "test:manifest": "node src/manifest.test.js",
    "test:diff": "node src/diff.test.js",
    "test:attacks": "node src/attacks.test.js"
  },
  "keywords": [
    "proveml",
    "verification",
    "ai",
    "markup",
    "provenance",
    "markdown-it",
    "fact-checking"
  ],
  "author": "Shane Deconinck <hello@shanedeconinck.be>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abovebeyond-ai/proveml.git"
  },
  "bugs": {
    "url": "https://github.com/abovebeyond-ai/proveml/issues"
  },
  "homepage": "https://abovebeyond.ai/proveml/",
  "peerDependencies": {
    "markdown-it": ">=14.0.0"
  },
  "devDependencies": {
    "markdown-it": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
